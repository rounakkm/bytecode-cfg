digraph CfgSample_sumPositives {
    graph [rankdir=TB fontname="Helvetica"];
    node  [fontname="Helvetica" fontsize=10];
    edge  [fontname="Helvetica" fontsize=9];

    B0 [shape=doublecircle label="ENTRY" style=filled fillcolor="#aee8c0"];
    B1 [shape=doublecircle label="EXIT" style=filled fillcolor="#f4a8a8"];
    B2 [shape=box label="int sum = 0;"];
    B3 [shape=box label="for (int n : numbers)"];
    B4 [shape=box label="return sum"];
    B5 [shape=box label="(empty)"];
    B6 [shape=box label="if (n > 0)"];
    B7 [shape=box label="sum += n;"];
    B8 [shape=box label="(empty)"];
    B9 [shape=box label="(empty)"];

    B0 -> B2;
    B2 -> B3;
    B3 -> B5 [label="true"];
    B3 -> B4 [label="false"];
    B4 -> B1;
    B5 -> B6;
    B6 -> B7 [label="true"];
    B6 -> B8 [label="false"];
    B7 -> B8;
    B8 -> B3 [label="loop-back"];
    B9 -> B1;
}
